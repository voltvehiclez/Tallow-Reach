export type InferPluginApi<TPlugin> = TPlugin extends RoomPlugin<string, infer TApi> ? TApi : Record<never, never>;
export type JoinRoom<TConfig extends BaseRoomConfig = JoinRoomConfig> = <const TPlugins extends readonly AnyRoomPlugin[] | undefined = undefined>(config: TConfig & {
  use?: TPlugins;
}, roomId: string) => RoomWithPlugins<TPlugins>;
export type SignalPeer = (peerTopic: string, signal: string) => unknown;
